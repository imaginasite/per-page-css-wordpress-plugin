msgid "Specific CSS for this page"
msgstr "Styles CSS pour cette page"

msgid "Specific CSS for this post"
msgstr "Styles CSS pour cet article"

msgid "Syntax highlighting disabled in your profile."
msgstr "La coloration syntaxique est désactivée dans votre profil."

msgid "JS Error: "
msgstr "Erreur JS : "

msgid "Timeout: wp.codeEditor unavailable"
msgstr "Temps écoulé : wp.codeEditor n'est pas disponible"

